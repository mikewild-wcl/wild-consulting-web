@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="home" class="hero-section">
    <div class="row align-items-start pt-5 pb-2">
        <div class="col-lg-4 text-center mb-4 mb-lg-0">
            <img class="hero-logo" src="~/images/wild-consulting-logo.png" alt="Wild Consulting Limited">
        </div>
        <div class="col-lg-8">
            <h1 class="display-4 font-weight-bold mb-4">Wild Consulting Limited</h1>
            <p class="lead mb-3">
                .NET, C# and Azure consultancy with over 20 years of experience delivering secure, scalable systems for government and regulated industries.
            </p>
            <p class="mb-4">
                Oxford-based expertise in ASP.NET Core, Azure cloud platforms, event-driven architecture, Aspire, and
                AI-enhanced engineering.
            </p>
            <a class="btn btn-primary btn-lg" href="#contact">Get in Touch</a>
        </div>
    </div>
</section>

<!-- Services Section -->
<section id="services" class="services-section py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 font-weight-bold">Our Services</h2>
        <p class="lead text-muted">Practical engineering leadership for modern Microsoft platforms</p>
    </div>

    <div class="row">
        <div id="dotnet-services-card" class="col-md-6 col-lg-3 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="card-body-img mb-3 d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" fill="currentColor" class="bi bi-code-slash text-primary" viewBox="0 0 16 16">
                            <path d="M10.478 1.647a.5.5 0 1 0-.956-.294l-4 13a.5.5 0 0 0 .956.294zM4.854 4.146a.5.5 0 0 1 0 .708L1.707 8l3.147 3.146a.5.5 0 0 1-.708.708l-3.5-3.5a.5.5 0 0 1 0-.708l3.5-3.5a.5.5 0 0 1 .708 0m6.292 0a.5.5 0 0 0 0 .708L14.293 8l-3.147 3.146a.5.5 0 0 0 .708.708l3.5-3.5a.5.5 0 0 0 0-.708l-3.5-3.5a.5.5 0 0 0-.708 0"/>
                        </svg>
                    </div>
                    <h3 class="card-title h4">.NET &amp; C#</h3>
                    <p class="card-text">Modern, maintainable applications built with the latest .NET and C# capabilities.</p>
                    <ul class="service-card-list list-unstyled small text-left mt-3">
                        <li class="mb-2">ASP.NET Core &amp; Blazor</li>
                        <li class="mb-2">Web APIs &amp; minimal APIs</li>
                        <li class="mb-2">Worker services &amp; integration</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div id="data-services-card" class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="card-body-img mb-3 d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" fill="currentColor" class="bi bi-database text-primary" viewBox="0 0 16 16">
                            <path d="M4.318 2.687C5.234 2.271 6.536 2 8 2s2.766.27 3.682.687C12.644 3.125 13 3.627 13 4c0 .374-.356.875-1.318 1.313C10.766 5.729 9.464 6 8 6s-2.766-.27-3.682-.687C3.356 4.875 3 4.373 3 4c0-.374.356-.875 1.318-1.313M13 5.698V7c0 .374-.356.875-1.318 1.313C10.766 8.729 9.464 9 8 9s-2.766-.27-3.682-.687C3.356 7.875 3 7.373 3 7V5.698c.271.202.58.378.904.525C4.978 6.711 6.427 7 8 7s3.022-.289 4.096-.777A5 5 0 0 0 13 5.698M14 4c0-1.007-.875-1.755-1.904-2.223C11.022 1.289 9.573 1 8 1s-3.022.289-4.096.777C2.875 2.245 2 2.993 2 4v9c0 1.007.875 1.755 1.904 2.223C4.978 15.71 6.427 16 8 16s3.022-.289 4.096-.777C13.125 14.755 14 14.007 14 13zm-1 4.698V10c0 .374-.356.875-1.318 1.313C10.766 11.729 9.464 12 8 12s-2.766-.27-3.682-.687C3.356 10.875 3 10.373 3 10V8.698c.271.202.58.378.904.525C4.978 9.71 6.427 10 8 10s3.022-.289 4.096-.777A5 5 0 0 0 13 8.698m0 3V13c0 .374-.356.875-1.318 1.313C10.766 14.729 9.464 15 8 15s-2.766-.27-3.682-.687C3.356 13.875 3 13.373 3 13v-1.302c.271.202.58.378.904.525C4.978 12.71 6.427 13 8 13s3.022-.289 4.096-.777c.324-.147.633-.323.904-.525"/>
                        </svg>
                    </div>
                    <h3 class="card-title h4">Azure</h3>
                    <p class="card-text">Eight years of hands-on Azure experience delivering secure, scalable cloud platforms.</p>
                    <ul class="service-card-list list-unstyled small text-left mt-3">
                        <li class="mb-2">Functions &amp; Container Apps</li>
                        <li class="mb-2">Service Bus &amp; Storage Queues</li>
                        <li class="mb-2">Managed Identity &amp; Key Vault</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div id="cloud-services-card" class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="card-body-img mb-3 d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" fill="currentColor" class="bi bi-cloud text-primary" viewBox="0 0 16 16">
                            <path d="M4.406 3.342A5.53 5.53 0 0 1 8 2c2.69 0 4.923 2 5.166 4.579C14.758 6.804 16 8.137 16 9.773 16 11.569 14.502 13 12.687 13H3.781C1.708 13 0 11.366 0 9.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383m.653.757c-.757.653-1.153 1.44-1.153 2.056v.448l-.445.049C2.064 6.805 1 7.952 1 9.318 1 10.785 2.23 12 3.781 12h8.906C13.98 12 15 10.988 15 9.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 4.825 10.328 3 8 3a4.53 4.53 0 0 0-2.941 1.1z"/>
                        </svg>
                    </div>
                    <h3 class="card-title h4">Aspire &amp; Distributed Systems</h3>
                    <p class="card-text">Local-first development and orchestration for observable, resilient cloud-native applications.</p>
                    <ul class="service-card-list list-unstyled small text-left mt-3">
                        <li class="mb-2">.NET Aspire orchestration</li>
                        <li class="mb-2">Event-driven architecture</li>
                        <li class="mb-2">OpenTelemetry &amp; Polly</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div id="ai-services-card" class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="card-body-img mb-3 d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" fill="currentColor" class="bi bi-robot text-primary" viewBox="0 0 16 16">
                            <path d="M6 12.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5M3 8.062C3 6.76 4.235 5.765 5.53 5.886a26.6 26.6 0 0 0 4.94 0C11.765 5.765 13 6.76 13 8.062v1.157a.93.93 0 0 1-.765.935c-.845.147-2.34.346-4.235.346s-3.39-.2-4.235-.346A.93.93 0 0 1 3 9.219zm4.542-.827a.25.25 0 0 0-.217.068l-.92.9a25 25 0 0 1-1.871-.183.25.25 0 0 0-.068.495c.55.076 1.232.149 2.02.193a.25.25 0 0 0 .189-.071l.754-.736.847 1.71a.25.25 0 0 0 .404.062l.932-.97a25 25 0 0 0 1.922-.188.25.25 0 0 0-.068-.495c-.538.074-1.207.145-1.98.189a.25.25 0 0 0-.166.076l-.754.785-.842-1.7a.25.25 0 0 0-.182-.135"/>
                            <path d="M8.5 1.866a1 1 0 1 0-1 0V3h-2A4.5 4.5 0 0 0 1 7.5V8a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1a1 1 0 0 0 1-1V9a1 1 0 0 0-1-1v-.5A4.5 4.5 0 0 0 10.5 3h-2zM14 7.5V13a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7.5A3.5 3.5 0 0 1 5.5 4h5A3.5 3.5 0 0 1 14 7.5"/>
                        </svg>
                    </div>
                    <h3 class="card-title h4">Technical Leadership</h3>
                    <p class="card-text">Hands-on technical leadership for complex programmes and multidisciplinary delivery teams.</p>
                    <ul class="service-card-list list-unstyled small text-left mt-3">
                        <li class="mb-2">Architecture &amp; code quality</li>
                        <li class="mb-2">Mentoring &amp; stakeholder engagement</li>
                        <li class="mb-2">GDS agile delivery</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section id="about" class="about-section py-5 bg-light">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="display-5 font-weight-bold mb-4 text-center">About Wild Consulting</h2>
            <p class="lead">
                Wild Consulting Limited provides .NET, C# and Azure engineering expertise, backed by more than 20 years of professional software delivery and eight years of hands-on Azure experience.
            </p>
            <p>
                <strong>Mike Wild</strong>, Director of Wild Consulting, designs and delivers secure, scalable systems using ASP.NET Core, Azure Functions, Container Apps, Service Bus, Storage Queues, Managed Identity and modern CI/CD practices.
            </p>
            <p>
                Mike has led delivery across government, insurance, banking, publishing and education, including the Defra Extended Producer Responsibility platform and GDS-compliant services for major public-sector programmes.
            </p>
            <p>
                His current work applies .NET Aspire to distributed application orchestration, environment parity, automated testing and observability with OpenTelemetry, alongside event-driven Azure architectures designed for resilience and scale.
            </p>
        </div>
    </div>
</section>

<!-- Skills Section -->
<section id="skills" class="skills-section py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 font-weight-bold">Technical Expertise</h2>
        <p class="lead text-muted">Deep Microsoft platform experience from architecture through production delivery</p>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <h3 class="h4 mb-3">Core Skills</h3>
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>.NET &amp; C#:</strong> ASP.NET Core, Blazor, Web APIs, worker services</li>
                        <li class="mb-2"><strong>Azure:</strong> App Services, Functions, Container Apps, Service Bus, Storage</li>
                        <li class="mb-2"><strong>Databases:</strong> SQL Server, Cosmos DB, EF Core, Dapper</li>
                        <li class="mb-2"><strong>Aspire:</strong> orchestration, local resources, integration testing, environment parity</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Architecture:</strong> distributed systems, messaging, event-driven processing</li>
                        <li class="mb-2"><strong>Resilience:</strong> Polly, OpenTelemetry, diagnostics</li>
                        <li class="mb-2"><strong>Delivery:</strong> Azure DevOps YAML, Bicep, Docker, KEDA</li>
                        <li class="mb-2"><strong>Testing:</strong> xUnit, Moq, Playwright, Azurite</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <h3 class="h4 mb-3">Complementary Expertise</h3>
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Generative AI:</strong> Semantic Kernel, Agent Framework, Azure OpenAI</li>
                        <li class="mb-2"><strong>RAG:</strong> Retrieval Augmented Generation, Graph RAG with Neo4j</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Leadership:</strong> mentoring, stakeholder engagement, code quality</li>
                        <li class="mb-2"><strong>Agile:</strong> GDS delivery and Scrum</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="contact-section py-5 bg-light">
    <div class="row">
        <div class="col-lg-6 mx-auto text-center">
            <h2 class="display-5 font-weight-bold mb-4">Get in Touch</h2>
            <p class="lead mb-4">
                Based in Oxford and available anywhere in the South and Midlands.
            </p>
            <p class="h5">
                <strong>Email:</strong> <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
            </p>
            <p class="mt-4">
                <strong>Phone:</strong> 07799 200 134
            </p>
            <div class="mt-4">
                <a href="https://www.github.com/mikewild-wcl" class="btn btn-outline-dark mr-2" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-github mr-1" viewBox="0 0 16 16">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
